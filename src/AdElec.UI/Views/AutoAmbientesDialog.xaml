<Window x:Class="AdElec.UI.Views.AutoAmbientesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AdElec.UI.ViewModels"
        xmlns:conv="clr-namespace:AdElec.UI.Converters"
        Title="AD-ELEC — Gestor de Ambientes y Artefactos Eléctricos"
        Width="1020" Height="700"
        MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White">

    <Window.Resources>
        <conv:IntToVisibilityConverter x:Key="IntToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Forzar Popups oscuros para todos los ComboBox y controles nativos ── -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252525"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF"/>

        <!-- ── Textos y etiquetas ── -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ── Estilo global ComboBoxItem dark ── -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E4A7C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Estilo global ComboBox dark ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>

        <!-- ── Botones ── -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#444"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- ── DataGrid dark ── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#242424"/>
            <Setter Property="AlternatingRowBackground" Value="#2B2B2B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#383838"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0E4A7C"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
                <DataTrigger Binding="{Binding RequiereVerificacion}" Value="True">
                    <Setter Property="Background" Value="#3D3520"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- Header Resumen -->
            <RowDefinition Height="Auto"/>    <!-- Toolbar -->
            <RowDefinition Height="*"/>       <!-- DataGrid -->
            <RowDefinition Height="Auto"/>    <!-- Panel detalle ambiente seleccionado -->
            <RowDefinition Height="Auto"/>    <!-- Warning SIN_CLASIFICAR -->
            <RowDefinition Height="Auto"/>    <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══ Header: Resumen Global y Métricas Eléctricas ═══════════════ -->
        <Border Grid.Row="0" Background="#181818" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                BorderBrush="#2F2F2F" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Gestor de Ambientes &amp; Cargas" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Verificá los recintos, asigná UFs/Pisos y visualizá los artefactos contenidos"
                               Foreground="#888" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Stats -->
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Ambientes" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalDetectados}" Style="{StaticResource ValueText}"
                               HorizontalAlignment="Center" Foreground="#4CAF50"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Seleccionados" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalSeleccionados}" Style="{StaticResource ValueText}"
                               HorizontalAlignment="Center" Foreground="#2196F3"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Área Total" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AreaTotalDisplay}" Style="{StaticResource ValueText}"
                               HorizontalAlignment="Center" Foreground="#4CAF50"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Luces 💡" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalLuminariasGlobal}" Style="{StaticResource ValueText}"
                               HorizontalAlignment="Center" Foreground="#FFD54F"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Tomas 🔌" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalTomasGlobal}" Style="{StaticResource ValueText}"
                               HorizontalAlignment="Center" Foreground="#64B5F6"/>
                </StackPanel>

                <StackPanel Grid.Column="6" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Carga Est." Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalCargaGlobalVA, StringFormat={}{0:F0} VA}" Style="{StaticResource ValueText}"
                               HorizontalAlignment="Center" Foreground="#FF8A65"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Toolbar ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="✓ Seleccionar todo" Style="{StaticResource BtnSmall}"
                        Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                <Button Content="✗ Deseleccionar todo" Style="{StaticResource BtnSmall}"
                        Command="{Binding DeselectAllCommand}" Margin="0,0,6,0"/>
                <Button Content="🔍 Zoom al recinto" Style="{StaticResource BtnSmall}"
                        Command="{Binding ZoomCommand}" Margin="0,0,6,0"/>
            </StackPanel>

            <TextBlock Text="💡 Podés editar UF, Piso y Tipo directamente en la tabla"
                       Foreground="#777" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- ══ DataGrid principal ════════════════════════════════════════ -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rooms}"
                  SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                  Margin="0,0,0,8">
            <DataGrid.Columns>

                <!-- Checkbox selección -->
                <DataGridTemplateColumn Header="☑" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Confianza (icono color) -->
                <DataGridTemplateColumn Header="" Width="28">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ConfianzaIcon}" HorizontalAlignment="Center"
                                       FontSize="13" ToolTip="{Binding Confianza}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Confianza}" Value="media">
                                                <Setter Property="Foreground" Value="#2196F3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Confianza}" Value="baja">
                                                <Setter Property="Foreground" Value="#FFC107"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ID -->
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" IsReadOnly="True"/>

                <!-- UF (editable ComboBox dark) -->
                <DataGridTemplateColumn Header="Unidad Funcional" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UnidadFuncional}" VerticalAlignment="Center" Padding="4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnidadFuncional}" Value="SIN_CLASIFICAR">
                                                <Setter Property="Foreground" Value="#FFC107"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.UfOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding UnidadFuncional, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Piso / Planta (editable ComboBox dark) -->
                <DataGridTemplateColumn Header="Piso / Planta" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Planta}" VerticalAlignment="Center" Padding="4,0" Foreground="#E0E0E0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.PlantasOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Planta, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Tipo de Ambiente (editable ComboBox dark) -->
                <DataGridTemplateColumn Header="Tipo de Ambiente" Width="175">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Tipo}" VerticalAlignment="Center" Padding="4,0" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.TiposLocal, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Nombre"
                                      SelectedValuePath="Nombre"
                                      SelectedValue="{Binding Tipo, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Área -->
                <DataGridTextColumn Header="Área (m²)" Width="75" IsReadOnly="True"
                                    Binding="{Binding AreaM2, StringFormat=F2}"/>

                <!-- Perímetro -->
                <DataGridTextColumn Header="Perím. (m)" Width="75" IsReadOnly="True"
                                    Binding="{Binding PerimetroM, StringFormat=F1}"/>

                <!-- Bocas Eléctricas en el Ambiente -->
                <DataGridTemplateColumn Header="Artefactos (Bocas)" Width="135" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡" Margin="0,0,2,0" FontSize="11"/>
                                <TextBlock Text="{Binding CantidadLuminarias}" FontWeight="SemiBold" Foreground="#FFD54F" Margin="0,0,8,0"/>
                                <TextBlock Text="🔌" Margin="0,0,2,0" FontSize="11"/>
                                <TextBlock Text="{Binding CantidadTomas}" FontWeight="SemiBold" Foreground="#64B5F6"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Circuitos en el Ambiente -->
                <DataGridTextColumn Header="Circuitos" Width="90" IsReadOnly="True"
                                    Binding="{Binding CircuitosDetalle}"/>

                <!-- Estado (Existente vs Nuevo) -->
                <DataGridTemplateColumn Header="Estado" Width="85" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="4,1" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1B3E2B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExisting}" Value="False">
                                                <Setter Property="Background" Value="#1B2D4A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EstadoTexto}" FontSize="10" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#81C784"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExisting}" Value="False">
                                                    <Setter Property="Foreground" Value="#64B5F6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ══ Panel de Detalle del Ambiente Seleccionado ═════════════════ -->
        <Border Grid.Row="3" Background="#181818" CornerRadius="4" Padding="12,10" Margin="0,0,0,10"
                BorderBrush="#333" BorderThickness="1"
                Visibility="{Binding HasSelectedRoom, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Recinto seleccionado: " Foreground="#888" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedRoom.Tipo}" FontWeight="Bold" Foreground="White" FontSize="12"/>
                        <TextBlock Text=" — " Foreground="#888"/>
                        <TextBlock Text="{Binding SelectedRoom.UnidadFuncional}" Foreground="#4CAF50" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text=" (" Foreground="#888"/>
                        <TextBlock Text="{Binding SelectedRoom.Planta}" Foreground="#90CAF9" FontSize="12"/>
                        <TextBlock Text=")" Foreground="#888"/>
                        <TextBlock Text=" | Superficie: " Foreground="#888" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding SelectedRoom.AreaM2, StringFormat={}{0:F2} m²}" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦 Cargas contenidas: " Foreground="#AAA" FontSize="11"/>
                        <TextBlock Text="💡 Luces: " Foreground="#AAA" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedRoom.CantidadLuminarias}" Foreground="#FFD54F" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock Text="🔌 Tomas: " Foreground="#AAA" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedRoom.CantidadTomas}" Foreground="#64B5F6" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock Text="⚡ Potencia est.: " Foreground="#AAA" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedRoom.PotenciaTotalVA, StringFormat={}{0:F0} VA}" Foreground="#FF8A65" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock Text="🔀 Circuitos: " Foreground="#AAA" FontSize="11"/>
                        <TextBlock Text="{Binding SelectedRoom.CircuitosDetalle}" Foreground="#CE93D8" FontWeight="SemiBold" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="🔍 Centrar en plano" Style="{StaticResource BtnSmall}"
                        Command="{Binding ZoomCommand}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- ══ Warning SIN_CLASIFICAR ════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#3D3520" CornerRadius="3" Padding="12,7" Margin="0,0,0,10"
                Visibility="{Binding SinClasificar, Converter={StaticResource IntToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="#FFC107" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" Foreground="#E0D0A0" FontSize="11"
                           Text="Hay ambientes sin unidad funcional asignada. Hacé doble clic en la columna Unidad Funcional para asignarla."/>
            </StackPanel>
        </Border>

        <!-- ══ Footer: Botones ═══════════════════════════════════════════ -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#777" FontSize="11"
                       Text="Doble clic en una celda para editar UF, Piso o Tipo. Hacé clic en una fila para resaltarla en AutoCAD."/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancelar" Style="{StaticResource BtnSecondary}"
                        Command="{Binding CancelarCommand}" Margin="0,0,8,0"/>
                <Button Content="Guardar y Actualizar Ambientes" Style="{StaticResource BtnPrimary}"
                        Command="{Binding InsertarCommand}" IsDefault="True"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
